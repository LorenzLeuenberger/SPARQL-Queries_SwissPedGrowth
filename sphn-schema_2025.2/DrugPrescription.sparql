PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?DrugPrescription ?SubjectPseudoIdentifier ?SubjectPseudoIdentifier_Identifier ?AdministrativeCase ?AdministrativeCase_Identifier
?DataProvider_InstitutionCode_Name ?FirstAdministrationDateTime ?LastAdministrationDateTime ?Intent ?IndicationToStart ?RecordDateTime
?Frequency_Value ?Frequency_Unit ?TimePattern_TypeCode_Label ?AdministrationRouteCode_Label
?Drug_Article_Name ?Drug_ActiveIngredient_GenericName ?Drug_Quantity_Value ?Drug_Quantity_Unit
?Drug_ActiveIngredient_GenericName_Code ?Drug_ActiveIngredient_GenericName_Code_Label ?Drug_ActiveIngredient_Quantity_Value ?Drug_ActiveIngredient_Quantity_Unit

WHERE {
    	?DrugPrescription a sphn:DrugPrescription .
   		OPTIONAL { ?DrugPrescription sphn:hasSubjectPseudoIdentifier ?SubjectPseudoIdentifier.
       		Optional { ?SubjectPseudoIdentifier sphn:hasIdentifier ?SubjectPseudoIdentifier_Identifier . }
    		OPTIONAL { ?SubjectPseudoIdentifier sphn:hasDataProvider/sphn:hasInstitutionCode/sphn:hasName ?DataProvider_InstitutionCode_Name .}}
    	optional { ?DrugPrescription sphn:hasAdministrativeCase ?AdministrativeCase . 
        	optional { ?AdministrativeCase sphn:hasIdentifier ?AdministrativeCase_Identifier . }}
        optional { ?DrugPrescription sphn:hasFirstAdministrationDateTime ?FirstAdministrationDateTime . }
        optional { ?DrugPrescription sphn:hasLastAdministrationDateTime ?LastAdministrationDateTime . }
		optional { ?DrugPrescription sphn:hasRecordDateTime ?RecordDateTime . }
        optional { ?DrugPrescription sphn:hasFrequency ?Frequency .
        			optional { ?Frequency sphn:hasValue ?Frequency_Value . }
        			optional { ?Frequency sphn:hasUnit/sphn:hasCode/rdf:type/rdfs:label ?Frequency_Unit . }}
        optional { ?DrugPrescription sphn:hasTimePattern/sphn:hasTypeCode/rdf:type ?TimePattern_TypeCode_Type . 
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_german . 
    							FILTER(LANG(?TimePattern_TypeCode_Label_german) = "de" )}
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_english . 
    							FILTER(LANG(?TimePattern_TypeCode_Label_english) = "en" )}
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_englishUS . 
    							FILTER(LANG(?TimePattern_TypeCode_Label_englishUS) = "en-US" )}
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_englishUK . 
    							FILTER(LANG(?TimePattern_TypeCode_Label_englishUK) = "en-UK" )}
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_french. 
    							FILTER(LANG(?TimePattern_TypeCode_Label_french) = "fr" )}
        			optional { ?TimePattern_TypeCode_Type skos:prefLabel ?TimePattern_TypeCode_Label_frenchCH. 
    							FILTER(LANG(?TimePattern_TypeCode_Label_frenchCH) = "fr-CH" )}
        			BIND(COALESCE(?TimePattern_TypeCode_Label_german, ?TimePattern_TypeCode_Label_english, ?TimePattern_TypeCode_Label_englishUS, ?TimePattern_TypeCode_Label_englishUK, ?TimePattern_TypeCode_Label_french, ?TimePattern_TypeCode_Label_frenchCH) AS ?TimePattern_TypeCode_Label)}
    	optional { ?DrugPrescription sphn:hasAdministrationRouteCode/rdf:type ?AdministrationRouteCode_Type . 
    				optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_german . 
    							FILTER(LANG(?AdministrationRouteCode_Label_german) = "de" )}
        			optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_english . 
    							FILTER(LANG(?AdministrationRouteCode_Label_english) = "en" )}
        			optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_englishUS . 
    							FILTER(LANG(?AdministrationRouteCode_Label_englishUS) = "en-US" )}
        			optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_englishUK . 
    							FILTER(LANG(?AdministrationRouteCode_Label_englishUK) = "en-UK" )}
        			optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_french. 
    							FILTER(LANG(?AdministrationRouteCode_Label_french) = "fr" )}
        			optional { ?AdministrationRouteCode_Type skos:prefLabel ?AdministrationRouteCode_Label_frenchCH. 
    							FILTER(LANG(?AdministrationRouteCode_Label_frenchCH) = "fr-CH" )}
        			BIND(COALESCE(?AdministrationRouteCode_Label_german, ?AdministrationRouteCode_Label_english, ?AdministrationRouteCode_Label_englishUS, ?AdministrationRouteCode_Label_englishUK, ?AdministrationRouteCode_Label_french, ?AdministrationRouteCode_Label_frenchCH) AS ?AdministrationRouteCode_Label)}
        optional { ?DrugPrescription sphn:hasIndicationToStart ?IndicationToStart .}
		optional { ?DrugPrescription sphn:hasDrug ?Drug .
        			optional { ?Drug sphn:hasArticle/sphn:hasName ?Drug_Article_Name . }
					optional { ?Drug sphn:hasQuantity ?Drug_Quantity .
            					optional { ?Drug_Quantity sphn:hasValue ?Drug_Quantity_Value .}
            					optional { ?Drug_Quantity sphn:hasUnit/sphn:hasCode/rdf:type/rdfs:label ?Drug_Quantity_Unit . }}
        			optional { ?Drug sphn:hasActiveIngredient ?Drug_ActiveIngredient . 
            					optional { ?Drug_ActiveIngredient sphn:hasGenericName ?Drug_ActiveIngredient_GenericName . }
    			            	optional { ?Drug_ActiveIngredient sphn:hasCode/rdf:type ?Drug_ActiveIngredient_GenericName_Code . 
            								optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_german . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_german) = "de" )}
        									optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_english . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_english) = "en" )}
                							optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_englishUS . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_englishUS) = "en-US" )}
                							optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_englishUK . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_englishUK) = "en-UK" )}
                							optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_french . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_french) = "fr" )}
                							optional { ?Drug_ActiveIngredient_GenericName_Code rdfs:label ?Drug_ActiveIngredient_GenericName_Code_Label_frenchCH . 
    													FILTER(LANG(?Drug_ActiveIngredient_GenericName_Code_Label_frenchCH) = "fr-CH" )}
        									BIND(COALESCE(?Drug_ActiveIngredient_GenericName_Code_Label_german, ?Drug_ActiveIngredient_GenericName_Code_Label_english, ?Drug_ActiveIngredient_GenericName_Code_Label_englishUS, ?Drug_ActiveIngredient_GenericName_Code_Label_englishUK, ?Drug_ActiveIngredient_GenericName_Code_Label_french, ?Drug_ActiveIngredient_GenericName_Code_Label_frenchCH) AS ?Drug_ActiveIngredient_GenericName_Code_Label)}
        						optional { ?Drug_ActiveIngredient sphn:hasQuantity ?Drug_ActiveIngredient_Quantity.
											optional { ?Drug_ActiveIngredient_Quantity sphn:hasValue ?Drug_ActiveIngredient_Quantity_Value .}
											optional { ?Drug_ActiveIngredient_Quantity sphn:hasUnit/sphn:hasCode/rdf:type/rdfs:label ?Drug_ActiveIngredient_Quantity_Unit .}}
							}

				}
		optional { ?DrugPrescription sphn:hasIntent/sphn:hasCode/rdf:type/rdfs:label ?Intent}
}